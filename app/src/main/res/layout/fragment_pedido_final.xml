<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">


    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_arrow_back"
        android:tint="@color/orange_main"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>


    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tu pedido"
        android:textStyle="bold"
        android:textSize="26sp"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"/>


    <TextView
        android:id="@+id/tvDirLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Dirección de entrega"
        android:textStyle="bold"
        android:textColor="@color/orange_main"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="14dp"/>

    <TextView
        android:id="@+id/tvDireccion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sin dirección"
        android:textColor="#333333"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvDirLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp"/>

    <View
        android:id="@+id/linea1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E6E6E6"
        app:layout_constraintTop_toBottomOf="@id/tvDireccion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPedido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/linea1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/sectionEntrega"/>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sectionEntrega"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/sectionPago"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/tvEntregaTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Tiempo de entrega"
            android:textStyle="bold"
            android:textColor="@color/orange_main"
            android:textSize="16sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvEntregaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entrega estimada:"
            android:textColor="#333333"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvEntregaTitle"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvEntregaEstimada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30 - 45 min"
            android:textStyle="bold"
            android:textColor="#111111"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvEntregaTitle"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInmediata"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeWidth="2dp"
            app:strokeColor="#E6E6E6"
            app:layout_constraintTop_toBottomOf="@id/tvEntregaLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cardProgramada"
            app:layout_constraintWidth_percent="0.48">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvInmediata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inmediata ⚡"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30 - 45 min"
                    android:textColor="#666666"
                    app:layout_constraintTop_toBottomOf="@id/tvInmediata"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="6dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProgramada"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeWidth="2dp"
            app:strokeColor="#E6E6E6"
            app:layout_constraintTop_toBottomOf="@id/tvEntregaLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardInmediata"
            app:layout_constraintWidth_percent="0.48">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvProgramada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Programada"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elige día y horario"
                    android:textColor="#666666"
                    app:layout_constraintTop_toBottomOf="@id/tvProgramada"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="6dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sectionPago"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">

        <TextView
            android:id="@+id/tvPagoTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Método de pago"
            android:textStyle="bold"
            android:textColor="@color/orange_main"
            android:textSize="16sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPago"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:endIconMode="dropdown_menu"
            app:boxStrokeColor="@color/orange_main"
            app:boxStrokeWidth="2dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:layout_constraintTop_toBottomOf="@id/tvPagoTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actMetodoPago"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:hint="Selecciona un método"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:background="@color/orange_main">

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total S/ 0.00"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHacerPedido"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Hacer pedido"
                android:textAllCaps="false"
                app:cornerRadius="22dp"
                app:backgroundTint="@android:color/white"
                android:textColor="@color/orange_main"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>