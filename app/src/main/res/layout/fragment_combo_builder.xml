<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Armar combo"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/black_text"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvPlatos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Elige tu plato"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/black_text"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPlatos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tvPlatos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


        <TextView
            android:id="@+id/tvBebidas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Elige tu bebida"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/black_text"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/rvPlatos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBebidas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tvBebidas"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


        <TextView
            android:id="@+id/tvPostre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Elige tu postre"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/black_text"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/rvBebidas"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPostres"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tvPostre"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmar"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="Confirmar combo"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/orange_main"
            android:textColor="@android:color/white"
            android:layout_marginTop="18dp"
            app:layout_constraintTop_toBottomOf="@id/rvPostres"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>